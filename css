body{
    margin:0;
    background:#0b0f1e;
    color:white;
    font-family:Arial,sans-serif;
}

.lobby{
    padding:30px;
}

.logo{
    text-align:center;
    font-size:42px;
    font-weight:900;
    margin-bottom:30px;
}

.game-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:20px;
}

.game-card{
    height:220px;
    border-radius:20px;
    overflow:hidden;
    position:relative;
    cursor:pointer;
}

.game-card img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.game-info{
    position:absolute;
    left:0;
    right:0;
    bottom:0;
    padding:20px;
    background:linear-gradient(
        transparent,
        rgba(0,0,0,.9)
    );
}

.game-name{
    font-size:24px;
    font-weight:bold;
}
